# ฐานข้อมูล PostgreSQL (เช่น Supabase / Neon / Railway หรือ docker compose ในเครื่อง)
DATABASE_URL="postgresql://guan:guan@localhost:5432/guan?schema=public"

# Auth.js — สร้างด้วย: npx auth secret  หรือ  openssl rand -base64 32
AUTH_SECRET=""
# URL จริงของเว็บตอน deploy (เช่น https://guan.vercel.app)
AUTH_URL="http://localhost:3000"

# LINE Login (สร้าง channel ที่ https://developers.line.biz/console/)
# Callback URL: <AUTH_URL>/api/auth/callback/line
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""

# LINE user id ของหัวก๊วน คั่นด้วย , (ถ้าว่าง คนแรกที่ล็อกอินจะเป็นหัวก๊วน)
ADMIN_LINE_IDS=""

# เปิดปุ่มล็อกอินทดสอบ (ห้ามเปิดบนเว็บจริง)
ALLOW_DEV_LOGIN="false"
