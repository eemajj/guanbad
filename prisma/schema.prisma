// ก๊วนแบด — data model
// Money is stored in satang (1 baht = 100 satang) as integers to avoid rounding errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// ที่แอปใช้ตอนรัน: บน Vercel ใช้ URL แบบ pooled (Neon "-pooler" / Supabase port 6543) เพราะ serverless เปิด connection บ่อย
  url       = env("DATABASE_URL")
  /// ที่ใช้รัน migration: ต่อตรง ไม่ผ่าน pooler (ในเครื่องใช้ค่าเดียวกับ DATABASE_URL)
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

/// เกณฑ์ประเมินมือของก๊วน (BG → P)
enum Level {
  BG
  N_MINUS
  N
  NS
  S
  P_MINUS
  P
}

enum SessionStatus {
  OPEN // เปิดรับชื่อ
  LIVE // กำลังตี
  CLOSED // จบรอบ ออกบิลแล้ว
}

enum FeeMode {
  SPLIT // หารค่าคอร์ทเท่ากันทุกคน
  FLAT // เก็บค่าคอร์ทคนละเท่ากัน
}

enum ParticipantStatus {
  ACTIVE
  RESTING
  LEFT
}

enum JoinSource {
  SELF
  ADMIN
}

enum MatchStatus {
  PLAYING
  DONE
  CANCELLED
}

enum Team {
  A
  B
}

enum ChargeStatus {
  UNPAID
  REPORTED // สมาชิกแจ้งว่าโอนแล้ว รอหัวก๊วนยืนยัน
  PAID
  WAIVED // ยกเว้นไม่เก็บ
}

enum ExpenseCategory {
  COURT
  SHUTTLE
  OTHER
}

model User {
  id        String   @id @default(cuid())
  lineId    String?  @unique
  email     String?  @unique
  name      String
  image     String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  member    Member?
}

model Member {
  id             String        @id @default(cuid())
  nickname       String
  fullName       String?
  phone          String?
  level          Level         @default(N)
  note           String?
  active         Boolean       @default(true)
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// PIN สำหรับเข้าระบบ (scrypt hash) ยังไม่ตั้ง = เข้าระบบไม่ได้
  pinHash        String?
  pinLength      Int?
  /// เพิ่มทุกครั้งที่เปลี่ยน PIN เพื่อให้ทุกเครื่องที่ล็อกอินค้างไว้หลุด
  pinVersion     Int           @default(0)
  /// ใส่ PIN ผิดติดกันกี่ครั้ง (ล้างเมื่อเข้าถูก หรือหัวก๊วนตั้ง PIN ใหม่)
  pinFailures    Int           @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  participations Participant[]
  matchPlayers   MatchPlayer[]
  charges        Charge[]

  @@index([nickname])
}

model Session {
  id           String        @id @default(cuid())
  venue        String
  date         DateTime      @db.Date
  startTime    String // "19:00"
  endTime      String // "21:00"
  /// ค่าคอร์ทต่อคอร์ทต่อชั่วโมง (สตางค์)
  courtRate    Int
  /// ราคาลูกต่อลูก (สตางค์)
  shuttlePrice Int
  feeMode      FeeMode       @default(SPLIT)
  /// ค่าคอร์ทต่อหัว เมื่อ feeMode = FLAT (สตางค์)
  flatFee      Int           @default(0)
  maxPlayers   Int?
  selfSignup   Boolean       @default(true)
  status       SessionStatus @default(OPEN)
  note         String?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  closedAt     DateTime?
  courts       Court[]
  participants Participant[]
  matches      Match[]
  charges      Charge[]
  expenses     Expense[]

  @@index([date])
}

model Court {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  matches   Match[]

  @@unique([sessionId, position])
}

model Participant {
  id        String            @id @default(cuid())
  sessionId String
  session   Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status    ParticipantStatus @default(ACTIVE)
  source    JoinSource        @default(ADMIN)
  joinedAt  DateTime          @default(now())
  /// เวลาที่เข้าคิวล่าสุด (มาถึง / จบเกม / กลับจากพัก) — ใช้เรียงคิว
  queuedAt  DateTime          @default(now())

  @@unique([sessionId, memberId])
}

model Match {
  id        String        @id @default(cuid())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courtId   String
  court     Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  status    MatchStatus   @default(PLAYING)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  /// ผลการแข่งไม่บังคับ: ว่าง = ลืมบันทึก, มีแค่ winner = รู้แค่ใครชนะ, มีแต้ม = winner คิดจากแต้ม
  winner    Team?
  scoreA    Int?
  scoreB    Int?
  shuttles  Int           @default(0)
  players   MatchPlayer[]

  @@index([sessionId, status])
}

model MatchPlayer {
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  team     Team

  @@id([matchId, memberId])
}

model Charge {
  id            String       @id @default(cuid())
  sessionId     String
  session       Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  courtFee      Int
  shuttleFee    Int
  shuttleCount  Float
  /// ยอดรวมปัดขึ้นเป็นบาทเต็ม (สตางค์)
  total         Int
  status        ChargeStatus @default(UNPAID)
  reportedAt    DateTime?
  paidAt        DateTime?
  confirmedById String?
  createdAt     DateTime     @default(now())

  @@unique([sessionId, memberId])
  @@index([status])
}

model Expense {
  id        String          @id @default(cuid())
  sessionId String?
  session   Session?        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  ExpenseCategory
  amount    Int
  note      String?
  spentAt   DateTime        @db.Date
  createdAt DateTime        @default(now())

  @@index([spentAt])
}

/// ตั้งค่าของก๊วน (มีแถวเดียว id = "main")
model Setting {
  id                  String  @id @default("main")
  groupName           String  @default("ก๊วนแบด")
  promptpayId         String?
  accountName         String?
  defaultVenue        String?
  defaultCourtRate    Int     @default(18000)
  defaultShuttlePrice Int     @default(8500)
}

/// PIN (หรือรหัสตั้งค่า) ที่ใส่ผิด แยกตาม IP ไว้กันการสุ่มเดาหลายชื่อจากเครื่องเดียว
model LoginFailure {
  id        String   @id @default(cuid())
  ip        String
  /// ชื่อที่ถูกลอง (ว่าง = รหัสตั้งค่า SETUP_CODE)
  memberId  String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
